# Password for the Postgres database
POSTGRES_PASSWORD=change-me

# JWT secret for authentication, must be at least 32 random bytes and base64 encoded
AUTH_JWT_SECRET_BASE64=replace-with-base64-of-at-least-32-random-bytes

# config model LLM local
OLLAMA_MODEL=qwen3-vi:latest
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Config bucket for storing files, can be any S3 compatible bucket (cloudflare r2)
R2_BUCKET=ten-bucket-cua-ban
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=access-key-id
R2_SECRET_ACCESS_KEY=secret-access-key

# Config for Gemini API key and project details
GEMINI_API_KEY=your-api-key-from-google-ai-studio

GEMINI_MODEL_35_FLASH_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_31_FLASH_LITE=gemini-3.1-flash-lite
GEMINI_MODEL_GEMMA_4_26B=gemma-4-26b-a4b-it
GEMINI_MODEL_GEMMA_4_31B=gemma-4-31b-it

GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite